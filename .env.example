# Шаблон локального конфига. Проще всего: make setup — он создаст .env и
# впишет сгенерированный секрет, ничего существующего не затирая.
#
# JWT_SECRET намеренно оставлен пустым: схема в src/plugins/env.ts требует от 32
# символов, поэтому голое `cp .env.example .env` уронит запуск с внятной
# ошибкой, а не поднимет приложение с секретом из публичного репозитория.
# Сгенерировать вручную: openssl rand -hex 32
JWT_SECRET=

# Необязательные, значения по умолчанию в схеме.
# NODE_ENV=development
# CORS_ORIGIN=*
# RATE_LIMIT_MAX=100
