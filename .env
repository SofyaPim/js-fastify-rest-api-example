# Шаблон локального конфига: make setup копирует его в .env.
#
# Значение JWT_SECRET годится для разработки и тестов как есть — оно лежит в
# публичном репозитории, поэтому в прод подставляется своё через окружение.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=dev-only-secret-do-not-use-in-production

# Трассировка включается только при указанном коллекторе. Читается напрямую из
# окружения, минуя схему: src/telemetry.ts исполняется раньше приложения.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=js-fastify-rest-api-example

# Необязательные, значения по умолчанию в схеме.
# JWT_EXPIRES_IN=1h
# NODE_ENV=development
# CORS_ORIGIN=*
# RATE_LIMIT_MAX=100
